# ── Database ──────────────────────────────────────────────────────
DATABASE_URL=postgresql+psycopg2://chika:chika_dev_pwd@localhost:5433/chika

# ── App ────────────────────────────────────────────────────────────
APP_NAME=Pinotte
# DEBUG=true en dev. En prod, MUST être false (sinon le boot lèvera une erreur
# si JWT_SECRET_KEY n'est pas surchargé).
DEBUG=true

# ── JWT ────────────────────────────────────────────────────────────
# OBLIGATOIRE en prod : générer via `openssl rand -hex 32` et mettre dans les
# secrets de ton hébergeur (Railway/Render/Fly). Ne JAMAIS commit la vraie valeur.
JWT_SECRET_KEY=change-me-to-a-long-random-string-at-least-32-chars
JWT_ALGORITHM=HS256
JWT_EXPIRE_DAYS=7

# ── CORS ───────────────────────────────────────────────────────────
# Comma-separated. En prod, mettre uniquement ton domaine.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# ── Sécurité ───────────────────────────────────────────────────────
# En prod, mettre false → /register répond 403, seuls les OWNERs peuvent créer
# des comptes. Met true seulement si tu veux laisser n'importe qui s'inscrire.
ENABLE_PUBLIC_SIGNUP=true
# Politique mot de passe : min N chars + au moins 1 chiffre (validé serveur)
PASSWORD_MIN_LENGTH=8

# ── Google OAuth (optionnel) ───────────────────────────────────────
# Pour activer "Continuer avec Google" sur la page de login :
#
# 1. Va sur https://console.cloud.google.com/apis/credentials
# 2. Create Credentials → OAuth client ID → type "Web application"
# 3. Authorized JavaScript origins :
#       http://localhost:5173      (dev)
#       https://app.pinotte.io     (prod)
# 4. Authorized redirect URIs : aucune (on utilise Google Identity Services
#    côté frontend, pas de redirect callback nécessaire)
# 5. Copie le Client ID ici (PAS le client secret, il n'est pas utilisé) :
GOOGLE_OAUTH_CLIENT_ID=

# Note : le même client_id est utilisé côté frontend (servi via l'endpoint
# public /api/auth/config). Pas de secret côté frontend, c'est ok — la
# vérification de signature côté serveur est ce qui empêche la forge.
